# ---------------------------------------------------------------------------
# DisputeDesk configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Claude -----------------------------------------------------------------
# Without a key the app still runs, using the offline rules engine (clearly
# labelled in the UI). With a key you get the full agent reasoning trace.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium
MAX_AGENT_TURNS=8

# --- PayPal -----------------------------------------------------------------
# mock    = in-memory simulated sandbox with 5 fixture disputes (default)
# sandbox = the real PayPal REST API, using the credentials below
PAYPAL_MODE=mock
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- App --------------------------------------------------------------------
DISPUTEDESK_DB=disputedesk.db
# Seller-side order records the agent reads in sandbox mode. Copy
# data/store.example.json to data/store.json and fill in your own orders.
SELLER_STORE_FILE=data/store.json
# Used only for the "hours saved" figure in the header.
MINUTES_SAVED_PER_DISPUTE=45
